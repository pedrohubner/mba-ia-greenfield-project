  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Original file name; must include an extension",
            "example": "aula.mp4"
          },
          "size_bytes": {
            "type": "number",
            "description": "Declared file size in bytes (max 10 GiB)",
            "example": 10485760
          },
          "content_type": {
            "type": "string",
            "description": "MIME type; `video/mp4` or `video/webm`",
            "example": "video/mp4"
          },
          "title": {
            "type": "string",
            "description": "Optional title; defaults to the filename without its extension",
            "example": "Minha aula"
          }
        },
        "required": [
          "filename",
          "size_bytes",
          "content_type"
        ]
      },
      "VideoProcessingStatus": {
        "type": "string",
        "enum": [
          "pending_upload",
          "uploaded",
          "processing",
          "ready",
          "failed"
        ]
      },
      "VideoPublicationStatus": {
        "type": "string",
        "enum": [
          "draft"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "Minha aula"
          },
          "original_filename": {
            "type": "string",
            "example": "aula.mp4"
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 10485760
          },
          "processing_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoProcessingStatus"
              }
            ]
          },
          "publication_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoPublicationStatus"
              }
            ]
          },
          "processing_error": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 3
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "container_format": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitrate": {
            "type": "number",
            "nullable": true,
            "example": 1500000
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET URL for the thumbnail; null until ready"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "public_id",
          "title",
          "original_filename",
          "content_type",
          "size_bytes",
          "processing_status",
          "publication_status",
          "processing_error",
          "duration_seconds",
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "container_format",
          "bitrate",
          "thumbnail_url",
          "created_at",
          "updated_at"
        ]
      },
      "UploadInstructionsDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864,
            "description": "Size of every non-last part"
          },
          "part_count": {
            "type": "number",
            "example": 160,
            "description": "ceil(size_bytes / part_size)"
          }
        },
        "required": [
          "part_size",
          "part_count"
        ]
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponseDto"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadInstructionsDto"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "SignPartUrlsDto": {
        "type": "object",
        "properties": {
          "part_numbers": {
            "example": [
              1,
              2,
              3
            ],
            "description": "1..100 distinct part numbers, each within 1..part_count",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "part_numbers"
        ]
      },
      "SignedPartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL (HTTP PUT)"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "SignPartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedPartUrlDto"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "parts",
          "expires_at"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"5d41402abc4b2a76b9719d911017c592\""
          },
          "size": {
            "type": "number",
            "example": 67108864
          }
        },
        "required": [
          "part_number",
          "etag",
          "size"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "description": "1..10000 parts with distinct part_number",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "PresignedUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GET URL served by object storage"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expires_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}